{
  "name": "applock-mcp",
  "version": "0.6.1",
  "description": "Lock and hide AI chats (Claude Code, Antigravity, ChatGPT) behind Touch ID or a passphrase. MCP server + browser extension.",
  "type": "module",
  "bin": {
    "applock-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "native",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "privacy",
    "chatgpt",
    "claude",
    "antigravity",
    "touch-id",
    "lock"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Harmantaj/applock-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
